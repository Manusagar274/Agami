# ---------------------------------------------------------------------------
# Agami by Haritha — environment variables
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon / Vercel Postgres compatible).
# Example: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# WhatsApp number that receives enquiries, digits only, with country code
# (no +, spaces or dashes). Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public site URL, used for metadata, OpenGraph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional social / contact links shown in the footer and contact page.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/agamiofficial/
NEXT_PUBLIC_CONTACT_EMAIL=agamiofficial01@gmail.com

# Random secret used to sign admin session tokens (JWT).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Seed script only: creates one admin user on first run.
ADMIN_EMAIL=admin@agamibyharitha.com
ADMIN_PASSWORD=

# Optional: enables in-admin image upload via Vercel Blob.
# Without this, paste image URLs directly in the admin product form.
BLOB_READ_WRITE_TOKEN=

# Optional: verification code from Google Search Console
# (Settings -> Ownership verification -> HTML tag -> just the content value).
GOOGLE_SITE_VERIFICATION=
