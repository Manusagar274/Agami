{
  "name": "agami-by-haritha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "drizzle-kit migrate && ( [ \"$RUN_SEED\" = \"true\" ] && tsx scripts/seed.ts || true ) && ( [ \"$RUN_IMAGE_UPDATE\" = \"true\" ] && tsx scripts/update-product-images.ts || true ) && ( [ \"$RUN_CURRENCY_UPDATE\" = \"true\" ] && tsx scripts/update-currency.ts || true ) && ( [ \"$RUN_DESCRIPTION_UPDATE\" = \"true\" ] && tsx scripts/update-descriptions.ts || true ) && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:update-images": "tsx --env-file=.env.local scripts/update-product-images.ts",
    "db:update-currency": "tsx --env-file=.env.local scripts/update-currency.ts",
    "db:update-descriptions": "tsx --env-file=.env.local scripts/update-descriptions.ts",
    "photos:process": "bash scripts/process-photos.sh"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
